# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
NODE_ENV=development

# ── Backend (NestJS) — port 4000 ─────────────────────────────────────────────
PORT=4000
JWT_SECRET=changeme-min-32-chars-replace-in-prod
DATABASE_URL=postgresql://pulseai:pulseai_secret@postgres:5432/pulseai_db
ALLOWED_ORIGINS=http://localhost:3000

# Backend → AI Service (internal)
AI_SERVICE_URL=http://ai-service:8001
INTERNAL_API_KEY=internal-secret-change-in-production

# ── AI Service (FastAPI) — port 8001 ─────────────────────────────────────────
# Shared secret used by backend to call ai-service
# INTERNAL_API_KEY=internal-secret-change-in-production

# Azure OpenAI (production)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Fallback LLMs (dev only)
OPENAI_API_KEY=
GEMINI_API_KEY=

# LangSmith (optional tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pulseai-development

# ── Frontend (Next.js) — port 3000 ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=pulseai
POSTGRES_PASSWORD=pulseai_secret
POSTGRES_DB=pulseai_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0