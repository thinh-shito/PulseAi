# App
ENVIRONMENT=development
NODE_ENV=development

# Backend (NestJS) — port 4000
PORT=4000
JWT_SECRET=changeme-min-32-chars-replace-in-prod
DATABASE_URL=postgresql://pulseai:pulseai_secret@postgres:5432/pulseai_db
ALLOWED_ORIGINS=http://localhost:3000

# Backend → AI Service (internal)
AI_SERVICE_URL=http://ai-service:8001
INTERNAL_API_KEY=internal-secret-change-in-production

# Frontend (Next.js) — port 3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# LLM API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENCODE_API_KEY=

# Database
POSTGRES_USER=pulseai
POSTGRES_PASSWORD=
POSTGRES_DB=pulseai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=

# HIS PostgreSQL
HIS_DATABASE_URL=postgresql://his_user:his_password@his-postgres:5432/his_db
HIS_DB_QUERY_FAST_MODEL=gpt-4o-mini

# Redis
REDIS_URL=redis://redis:6379/0

# Langfuse
LANGFUSE_SECRET_KEY=your-langfuse-secret
LANGFUSE_PUBLIC_KEY=your-langfuse-public
LANGFUSE_HOST=https://cloud.langfuse.com